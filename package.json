{
  "name": "synapse",
  "version": "0.1.0-beta.18",
  "description": "The nervous system between AI agent ecosystems \u2014 any harness, any provider, subscription or API, local or cloud. Agent-agnostic multi-agent orchestrator.",
  "homepage": "https://github.com/ohgurlabs/synapse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohgurlabs/synapse.git"
  },
  "bugs": {
    "url": "https://github.com/ohgurlabs/synapse/issues"
  },
  "author": "Ohgur Labs",
  "main": "src/orchestrator.js",
  "bin": {
    "synapse": "src/cli.js"
  },
  "scripts": {
    "start": "node --env-file=.env src/orchestrator.js",
    "dev": "node --env-file=.env src/orchestrator.js --dev",
    "test": "node test.mjs",
    "test:ui": "playwright test",
    "migrate:timeline": "node scripts/run-migrations.js up",
    "migrate:timeline:status": "node scripts/run-migrations.js status",
    "verify:recovery": "bash scripts/verify-recovery-artifacts.sh",
    "verify:docs": "bash scripts/verify-doc-endpoints.sh",
    "verify:tasks": "bash scripts/verify-task-claims.sh",
    "verify:runtime-guardrails": "node scripts/runtime-guardrails.js",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "check:openapi-completeness": "node scripts/check-openapi-completeness.mjs"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test.cjs",
    "!src/**/*.test.mjs",
    "!src/**/*.spec.js",
    "!src/**/*.bak",
    "!src/**/*.bak.*",
    "!src/**/*.backup",
    "!src/**/*.sqlite",
    "!src/**/*.sqlite-shm",
    "!src/**/*.sqlite-wal",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/designs",
    "docs/landing",
    "docs/screenshots",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "Dockerfile",
    "scripts/git-daily-maintenance.sh",
    "scripts/kill-orphans.sh"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "multi-agent",
    "agent-agnostic",
    "mcp",
    "claude",
    "codex",
    "gemini",
    "ollama",
    "glm",
    "llm",
    "local-llm",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "diff": "^8.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "2026.1.14",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^2.1.1",
    "better-sqlite3": "^12.6.2",
    "pdfkit": "^0.16.0",
    "prom-client": "^15.1.3",
    "uplot": "^1.6.32",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@playwright/test": "^1.58.2",
    "chai": "^6.2.2",
    "chrome-launcher": "^1.1.4",
    "eslint": "^10.1.0",
    "eventsource": "^4.1.0",
    "lighthouse": "^13.4.1",
    "mocha": "^11.8.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}