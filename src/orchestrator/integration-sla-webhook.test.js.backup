// integration-sla-webhook.test.js — Integration tests for SLA webhook delivery:
// - Local HTTP server receives sla_breach events with correct HMAC signature
// - Webhook payload contains all required fields
// - Breach→resolve lifecycle works with webhook delivery

import { strict as assert } from 'assert';
import { EventEmitter } from 'events';
import { createServer } from 'http';
import { mkdtempSync, rmSync } from 'fs';
import { join } from 'path';
import { tmpdir } from 'os';
import { createSLAMonitor } from './sla-monitor.js';
import { EventBus } from '../events.js';
import { TimelineStore } from './timeline-store.js';
import { PerformanceStore } from '../performance-store.js';
import { WebhookStore } from './webhooks-store.js';
import { createWebhookDispatcher } from './webhooks.js';
import { createHmac } from 'crypto';

const tmpDir = mkdtempSync(join(tmpdir(), 'synapse-int-sla-webhook-'));
const timelineDbPath = join(tmpDir, 'timeline.db');

// Suppress noisy log output during tests
const savedLogLevel = process.env.SYNAPSE_LOG_LEVEL;
process.env.SYNAPSE_LOG_LEVEL = 'error';

let receivedWebhooks = [];
let webhookServer = null;

function createTestWebhookServer(port) {
  return new Promise((resolve) => {
    const server = createServer((req, res) => {
      let body = '';
      req.on('data', (chunk) => { body += chunk; });
      req.on('end', () => {
        receivedWebhooks.push({
          url: req.url,
          headers: req.headers,
          body: JSON.parse(body),
        });
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ ok: true }));
      });
    });
    server.listen(port, () => resolve(server));
  });
}

function verifyHmacSignature(secret, body, signature) {
  const expected = 'sha256=' + createHmac('sha256', secret).update(body).digest('hex');
  return signature === expected;
}

async function testSlaBreachWebhookDelivery() {
  console.log('\nTest: SLA breach webhook delivery with HMAC signature');
  
  receivedWebhooks = [];
  
  const eventBus = new EventBus();
  
  // Create timeline store
  const timelineStore = new TimelineStore({ dbPath: timelineDbPath });
  
  // Create performance store
  const perfStore = new PerformanceStore(tmpDir);
  
  // Create webhook store and dispatcher
  const webhookStore = new WebhookStore(tmpDir);
  const projectId = 'test-project';
  
  const webhookSecret = 'test_webhook_secret_key_32bytes_long!!';
  webhookStore.create(projectId, {
    url: 'http://localhost:18765/webhook',
    events: ['alert:sla_breach'],
    description: 'SLA breach test webhook',
  });
  
  // Override the store to use our secret for testing
  const hooks = webhookStore.list(projectId);
  const hook = webhookStore.get(projectId, hooks[0].id);
  hook.secret = webhookSecret;
  webhookStore._save(projectId, [hook]);
  
  const dispatcher = createWebhookDispatcher({ events: eventBus, config: {}, baseDir: tmpDir });
  
  // Start local webhook server
  webhookServer = await createTestWebhookServer(18765);
  
  // Configure SLA monitor with hourly_cost threshold
  const monitor = createSLAMonitor({
    events: eventBus,
    config: {
      sla: {
        hourly_cost: { enabled: true, thresholdUsd: 10.0, windowMinutes: 60 },
      },
    },
    performanceStore: perfStore,
    timelineStore,
  });
  
  // Inject cost data that exceeds threshold
  timelineStore.db.prepare(`
    INSERT INTO cost_events (id, event_ts, agent_id, provider, model, input_tokens, output_tokens, cost_usd, dispatch_id, trace_id, task_id, event_data, created_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    'cost-test-1',
    new Date().toISOString(),
    'test-agent',
    'test-provider',
    'test-model',
    1000,
    1000,
    8.0, // $8 per dispatch
    'dispatch-1',
    'trace-1',
    'task-1',
    '{}',
    new Date().toISOString()
  );
  
  timelineStore.db.prepare(`
    INSERT INTO cost_events (id, event_ts, agent_id, provider, model, input_tokens, output_tokens, cost_usd, dispatch_id, trace_id, task_id, event_data, created_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    'cost-test-2',
    new Date().toISOString(),
    'test-agent',
    'test-provider',
    'test-model',
    1000,
    1000,
    8.0, // $8 per dispatch
    'dispatch-2',
    'trace-2',
    'task-2',
    '{}',
    new Date().toISOString()
  );
  
  console.log('  Starting webhook dispatcher...');
  dispatcher.start();
  await new Promise(resolve => setTimeout(resolve, 100));
  
  // Add debug listener to EventBus
  eventBus.on('alert:sla_breach', (data) => {
    console.log('  EventBus received alert:sla_breach:', data.slaType);
  });
  
  // Trigger SLA evaluation
  monitor.tick();
  
  // Give webhook dispatcher time to deliver
  await new Promise(resolve => setTimeout(resolve, 1000));
  
  // Assert webhook was delivered
  assert.equal(receivedWebhooks.length, 1, 'should deliver one webhook');
  
  const webhook = receivedWebhooks[0];
  assert.strictEqual(webhook.url, '/webhook', 'should POST to /webhook');
  assert.strictEqual(webhook.headers['content-type'], 'application/json');
  assert.strictEqual(webhook.headers['x-synapse-event'], 'alert:sla_breach');
  
  // Verify HMAC signature
  const body = JSON.stringify(webhook.body);
  const signature = webhook.headers['x-synapse-signature'];
  assert.ok(signature, 'should have X-Synapse-Signature header');
  assert.ok(verifyHmacSignature(webhookSecret, body, signature), 'HMAC signature should be valid');
  
  // Verify payload structure
  const data = webhook.body.data;
  assert.strictEqual(data.slaType, 'hourly_cost');
  assert.strictEqual(data.threshold, 10.0);
  assert.ok(data.actual > 10.0, 'actual cost should exceed threshold');
  assert.ok(data.breachedAt, 'should have breachedAt timestamp');
  
  console.log('  PASS: SLA breach webhook delivery with HMAC signature');
  
  // Cleanup
  dispatcher.stop();
  webhookServer.close();
  timelineStore.close();
}

async function testSlaResolveWebhookDelivery() {
  console.log('\nTest: SLA resolution webhook delivery');
  
  receivedWebhooks = [];
  
  const eventBus = new EventBus();
  
  // Create timeline store
  const timelineStore = new TimelineStore({ dbPath: timelineDbPath });
  
  // Create performance store
  const perfStore = new PerformanceStore(tmpDir);
  
  // Create webhook store and dispatcher
  const webhookStore = new WebhookStore(tmpDir);
  const projectId = 'test-project-2';
  
  const webhookSecret = 'test_webhook_secret_key_32bytes_long!!';
  webhookStore.create(projectId, {
    url: 'http://localhost:18766/webhook',
    events: ['alert:sla_breach', 'alert:sla_resolved'],
    description: 'SLA lifecycle test webhook',
  });
  
  const hooks = webhookStore.list(projectId);
  const hook = webhookStore.get(projectId, hooks[0].id);
  hook.secret = webhookSecret;
  webhookStore._save(projectId, [hook]);
  
  const dispatcher = createWebhookDispatcher({ events: eventBus, config: {}, baseDir: tmpDir });
  dispatcher.start();
  
  // Start local webhook server
  webhookServer = await createTestWebhookServer(18766);
  
  // Configure SLA monitor with hourly_cost threshold
  const monitor = createSLAMonitor({
    events: eventBus,
    config: {
      sla: {
        hourly_cost: { enabled: true, thresholdUsd: 10.0, windowMinutes: 60 },
      },
    },
    performanceStore: perfStore,
    timelineStore,
  });
  
  // Inject cost data that exceeds threshold (breach)
  timelineStore.db.prepare(`
    INSERT INTO cost_events (id, event_ts, agent_id, provider, model, input_tokens, output_tokens, cost_usd, dispatch_id, trace_id, task_id, event_data, created_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    'cost-test-1',
    new Date().toISOString(),
    'test-agent',
    'test-provider',
    'test-model',
    1000,
    1000,
    8.0, // $8 per dispatch
    'dispatch-1',
    'trace-1',
    'task-1',
    '{}',
    new Date().toISOString()
  );
  
  timelineStore.db.prepare(`
    INSERT INTO cost_events (id, event_ts, agent_id, provider, model, input_tokens, output_tokens, cost_usd, dispatch_id, trace_id, task_id, event_data, created_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    'cost-test-2',
    new Date().toISOString(),
    'test-agent',
    'test-provider',
    'test-model',
    1000,
    1000,
    8.0, // $8 per dispatch
    'dispatch-2',
    'trace-2',
    'task-2',
    '{}',
    new Date().toISOString()
  );
  
  // Trigger breach
  monitor.tick();
  await new Promise(resolve => setTimeout(resolve, 300));
  
  assert.equal(receivedWebhooks.filter(w => w.body.data?.slaType === 'hourly_cost').length, 1, 'should receive breach webhook');
  
  // Clear breach by removing cost events (simulate fresh window)
  const deleteStmt = timelineStore.db.prepare('DELETE FROM cost_events WHERE dispatch_id IN ("dispatch-1", "dispatch-2")');
  deleteStmt.run();
  
  // Trigger resolution check
  monitor.tick();
  await new Promise(resolve => setTimeout(resolve, 300));
  
  // Assert resolution webhook was delivered
  const resolveWebhooks = receivedWebhooks.filter(w => w.body.data?.slaType === 'hourly_cost' && w.body.data?.resolvedAt);
  assert.equal(resolveWebhooks.length, 1, 'should deliver one resolution webhook');
  
  const resolveWebhook = resolveWebhooks[0];
  assert.ok(resolveWebhook.body.data.resolvedAt, 'resolution should have resolvedAt timestamp');
  
  console.log('  PASS: SLA resolution webhook delivery');
  
  // Cleanup
  dispatcher.stop();
  webhookServer.close();
  timelineStore.close();
}

async function testHourlyCostNoDataGraceful() {
  console.log('\nTest: hourly_cost SLA gracefully handles empty cost data');
  
  const eventBus = new EventEmitter();
  let breachEvents = [];
  eventBus.on('alert:sla_breach', (e) => breachEvents.push(e));
  
  const timelineStore = new TimelineStore({ dbPath: timelineDbPath });
  const perfStore = new PerformanceStore(tmpDir);
  
  // Ensure cost table is empty
  timelineStore.db.prepare('DELETE FROM cost_events').run();
  
  const monitor = createSLAMonitor({
    events: eventBus,
    config: {
      sla: {
        hourly_cost: { enabled: true, thresholdUsd: 10.0, windowMinutes: 60 },
      },
    },
    performanceStore: perfStore,
    timelineStore,
  });
  
  monitor.tick();
  
  assert.equal(breachEvents.length, 0, 'should not breach when cost data is empty');
  assert.equal(monitor.getActiveBreaches().length, 0);
  
  console.log('  PASS: hourly_cost gracefully handles empty cost data');
  
  timelineStore.close();
}

async function runTests() {
  try {
    await testSlaBreachWebhookDelivery();
    await testSlaResolveWebhookDelivery();
    await testHourlyCostNoDataGraceful();
    console.log('\n✓ All SLA webhook integration tests passed!');
  } catch (err) {
    console.error('\n✗ Test failed:', err.message);
    console.error(err.stack);
    process.exit(1);
  } finally {
    // Cleanup
    process.env.SYNAPSE_LOG_LEVEL = savedLogLevel;
    try { rmSync(tmpDir, { recursive: true, force: true }); } catch {}
  }
}

runTests();
